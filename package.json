    },
    "./composition": {
      "types": "./dist/public/composition.d.ts",
      "import": "./packages/composition/src/index.ts"
    },
    "./endpoint-kit": {
      "types": "./dist/public/endpoint-kit.d.ts",
      "import": "./packages/endpoint-kit/src/index.ts"
    },
    "./generation": {
