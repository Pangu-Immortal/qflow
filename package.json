{
  "name": "@qflow/qflow",
  "version": "0.1.11",
  "homepage": "https://qflow.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qflow-ai/qflow.git"
  },
  "description": "Qflow video authoring Distribution for AI agents",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "exports": {
    "./browser-capture": {
      "types": "./dist/public/browser-capture.d.ts",
      "import": "./packages/browser-capture/src/index.ts"
    },
    "./artifact": {
      "types": "./dist/public/artifact.d.ts",
      "import": "./packages/artifact/src/index.ts"
    },
    "./author-kit": {
      "types": "./dist/public/author-kit.d.ts",
      "import": "./packages/author-kit/src/index.ts"
    },
