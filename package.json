{
  "name": "@qflow/repository",
  "version": "0.0.1",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "bin": {
    "qflow": "./bin/qflow.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "node --import tsx --test 'packages/*/test/**/*.test.ts' 'services/*/test/**/*.test.ts' 'test/**/*.test.ts'",
    "test:release": "node --import tsx --test test/repository-hygiene.test.mjs",
    "test:whisperx-service": "uv run --project services/whisperx --frozen python -m unittest discover -s services/whisperx/tests -p 'test_*.py'",
    "test:browser-visual": "QFLOW_BROWSER_TESTS=1 node --import tsx --test packages/hyperframes/test/browser-visual.test.ts",
    "test:image-opencv": "QFLOW_OPENCV_TESTS=1 QFLOW_OPENCV_PYTHON=services/image-opencv/.venv/bin/python node --import tsx --test packages/provider-image-opencv-local/test/provider.test.ts",
    "smoke:kie": "node --import tsx packages/provider-kie/test/live-smoke.ts",
    "qflow": "node bin/qflow.mjs",
    "studio": "pnpm --filter @qflow/studio exec node --import tsx start.ts",
    "build:media-lambda": "pnpm --filter @qflow/media-lambda build",
    "build:media-lambda-layer": "pnpm --filter @qflow/media-lambda build:layer"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.33.0 <11"
  },
  "devDependencies": {
    "@qflow/artifact": "workspace:*",
    "@qflow/artifact-store-fs": "workspace:*",
    "@qflow/artifact-store-s3": "workspace:*",
    "@qflow/audio-track": "workspace:*",
    "@qflow/background-removal": "workspace:*",
    "@qflow/caption": "workspace:*",
    "@qflow/caption-fine": "workspace:*",
    "@qflow/caption-gemini": "workspace:*",
    "@qflow/comment-sticker": "workspace:*",
    "@qflow/composition": "workspace:*",
    "@qflow/credential-store-env": "workspace:*",
    "@qflow/credential-store-keychain": "workspace:*",
    "@qflow/deck-track": "workspace:*",
    "@qflow/estimate": "workspace:*",
    "@qflow/film": "workspace:*",
    "@qflow/fonts-open": "workspace:*",
    "@qflow/gemini-omni": "workspace:*",
    "@qflow/generation": "workspace:*",
    "@qflow/gpt-image": "workspace:*",
    "@qflow/grok-imagine": "workspace:*",
    "@qflow/hyperframes": "workspace:*",
    "@qflow/image-compose": "workspace:*",
    "@qflow/image-transform": "workspace:*",
    "@qflow/runtime-local": "workspace:*",
    "@qflow/media": "workspace:*",
    "@qflow/media-track": "workspace:*",
    "@qflow/media-pipeline": "workspace:*",
    "@qflow/minimax-h3": "workspace:*",
    "@qflow/mimo-tts": "workspace:*",
    "@qflow/nano-banana": "workspace:*",
    "@qflow/narrative": "workspace:*",
    "@qflow/program-space": "workspace:*",
    "@qflow/protocol": "workspace:*",
    "@qflow/provider-google-vertex": "workspace:*",
    "@qflow/provider-hyperframes-aws-lambda": "workspace:*",
    "@qflow/provider-hyperframes-local": "workspace:*",
    "@qflow/provider-image-opencv-local": "workspace:*",
    "@qflow/provider-kie": "workspace:*",
    "@qflow/provider-media-aws-lambda": "workspace:*",
    "@qflow/provider-media-local": "workspace:*",
    "@qflow/provider-whisperx-local": "workspace:*",
    "@qflow/provider-xiaomi-mimo": "workspace:*",
    "@qflow/ranking": "workspace:*",
    "@qflow/raster": "workspace:*",
    "@qflow/render-hyperframes": "workspace:*",
    "@qflow/run-markup": "workspace:*",
    "@qflow/runtime-kit": "workspace:*",
    "@qflow/runtime-host-node": "workspace:*",
    "@qflow/screen-overlay": "workspace:*",
    "@qflow/script": "workspace:*",
    "@qflow/seedance": "workspace:*",
    "@qflow/seedance-kits": "workspace:*",
    "@qflow/seedream": "workspace:*",
    "@qflow/semantic-track": "workspace:*",
    "@qflow/spatial": "workspace:*",
    "@qflow/speech": "workspace:*",
    "@qflow/speech-alignment": "workspace:*",
    "@qflow/speech-evidence": "workspace:*",
    "@qflow/speech-track": "workspace:*",
    "@qflow/store-sqlite": "workspace:*",
    "@qflow/svs": "workspace:*",
    "@qflow/temporal": "workspace:*",
    "@qflow/text": "workspace:*",
    "@qflow/typography-track": "workspace:*",
    "@qflow/visual-ir": "workspace:*",
    "@qflow/whisperx": "workspace:*",
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitepress": "^1.6.4"
  }
}
