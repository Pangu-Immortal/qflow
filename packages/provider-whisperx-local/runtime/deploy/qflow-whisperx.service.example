[Unit]
Description=SVML WhisperX alignment service
After=network.target

[Service]
Type=simple
User=qflow
WorkingDirectory=/opt/qflow
Environment=QFLOW_WHISPERX_PORT=8765
Environment=QFLOW_WHISPERX_MODEL=small
Environment=QFLOW_WHISPERX_DEVICE=cpu
Environment=QFLOW_WHISPERX_COMPUTE=int8
Environment=QFLOW_WHISPERX_BATCH_SIZE=8
Environment=QFLOW_WHISPERX_INPUT_ROOTS=/tmp
Environment=QFLOW_WHISPERX_NLTK_DATA=/var/cache/qflow/whisperx/nltk_data
Environment=OMP_NUM_THREADS=2
Environment=TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
ExecStartPre=/opt/qflow/packages/provider-whisperx-local/runtime/.venv/bin/qflow-whisperx-check
ExecStart=/opt/qflow/packages/provider-whisperx-local/runtime/.venv/bin/qflow-whisperx-service
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
