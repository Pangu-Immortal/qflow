<?svml using="@qflow/markup@1"?>
<!-- A wordless catalogue composition using this package's two sample graphics.
     The samples are the displayed content. Their frame treatments demonstrate fit,
     padding, clipping and motion; build.svrun renders the same composition. -->
<svml>
  <import as="media" from="@qflow/media@1"/>
  <import as="pipeline" from="@qflow/media-pipeline@1"/>
  <import as="time" from="@qflow/timeline-author@1"/>
  <import as="visual" from="@qflow/visual-track@1"/>
  <import as="space" from="@qflow/spatial@1"/>
  <import as="film" from="@qflow/film@1"/>
  <import as="render" from="@qflow/render-hyperframes@1"/>
  <import as="recipes" source="./recipes.svs"/>

  <space:Canvas id="vertical" width="720" height="1280"/>
  <time:Clock id="clock" frame-rate="30"/>
  <space:Frame id="full" within={vertical.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="card-a" within={vertical.bounds}
    left="8%" top="16%" right="92%" bottom="46%"/>
  <space:Frame id="card-b" within={vertical.bounds}
    left="12%" top="52%" right="88%" bottom="78%"/>
  <space:Extent id="picture-size" width="640" height="360"/>
  <media:Image id="picture-a" src="./rounded.png"/>
  <media:Image id="picture-b" src="./flush.png"/>

  <pipeline:StillVideo id="duration" source={picture-a} duration="5" clock={clock}/>
  <pipeline:Normalize id="duration-media" source={duration.video} clock={clock}
    video="primary-moving" audio="none" span-authority="video"/>
  <time:Timeline id="speech" clock={clock} end="showcase.end">
    <time:Window id="showcase" from="start" for={duration-media.extent}/>
  </time:Timeline>

  <visual:Motion id="card-motion">
    <visual:Pose at="start" y="80" opacity="0" easing="ease-out"/>
    <visual:Pose at="5f" y="0" opacity="1"/>
    <visual:Pose at="end-5f" y="0" opacity="1" easing="ease-in"/>
    <visual:Pose at="end" y="0" opacity="0"/>
  </visual:Motion>

  <visual:Track id="showcase" timeline={speech.timeline}>
    <visual:Clip id="rounded-card" image={picture-a} extent={picture-size} during="timeline"
      frame={card-a} z="40" fit="cover" treatment={recipes.media.card} motion={card-motion}/>
    <visual:Clip id="flush-card" image={picture-b} extent={picture-size} during="timeline"
      frame={card-b} z="41" fit="cover" treatment={recipes.media.wide} motion={card-motion}/>
  </visual:Track>
  <film:Film id="main" canvas={vertical.canvas} timeline={speech.timeline} appearance={recipes.film.vertical}>
    <film:Track source={showcase.visual}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={speech.timeline}/>
</svml>
