{
  "format": "qflow.runtime-profile@1",
  "runtime": {
    "use": "@qflow/runtime-local",
    "config": {
      "dataRoot": ".qflow/runtimes/local",
      "artifacts": {
        "use": "@qflow/artifact-store-fs",
        "config": { "path": "artifacts" }
      },
      "credentials": {
        "os": { "use": "@qflow/credential-store-os" }
      },
      "endpoints": {
        "kie.qflow-interview": {
          "use": "@qflow/provider-kie",
          "pool": "generation",
          "config": {
            "apiKey": { "store": "os", "key": "KIE_API_KEY" },
            "defaultConcurrency": 10,
            "laneConcurrency": { "seedance-2-mini": 10 }
          }
        },
        "media.qflow-interview": {
          "use": "@qflow/provider-media-local",
          "pool": "media",
          "config": { "defaultConcurrency": 2 }
        },
        "whisperx.qflow-interview": {
          "use": "@qflow/provider-whisperx-local",
          "pool": "alignment",
          "config": {
            "expectedModel": "large-v3",
            "defaultConcurrency": 1
          }
        },
        "hyperframes.qflow-interview": {
          "use": "@qflow/provider-hyperframes-local",
          "pool": "render",
          "config": {
            "workers": 2,
            "quality": "standard",
            "defaultConcurrency": 1
          }
        }
      }
    }
  }
}
