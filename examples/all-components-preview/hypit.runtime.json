{
  "format": "qflow.runtime-profile@1",
  "runtime": {
    "use": "@qflow/runtime-local",
    "config": {
      "dataRoot": ".qflow/runtimes/local",
      "artifacts": { "use": "@qflow/artifact-store-fs", "config": { "path": "artifacts" } },
      "credentials": {
        "environment": { "use": "@qflow/credential-store-env" }
      },
      "endpoints": {
        "kie.all-components": {
          "use": "@qflow/provider-kie",
          "pool": "generation",
          "config": {
            "apiKey": { "store": "env", "key": "KIE_API_KEY" },
            "defaultConcurrency": 2
          }
        },
        "media.all-components": {
          "use": "@qflow/provider-media-local",
          "pool": "media",
          "config": { "defaultConcurrency": 2 }
        },
        "whisperx.all-components": {
          "use": "@qflow/provider-whisperx-local",
          "pool": "alignment",
          "config": { "defaultConcurrency": 1 }
        },
        "hyperframes.all-components": {
          "use": "@qflow/provider-hyperframes-local",
          "pool": "render",
          "config": { "defaultConcurrency": 1 }
        }
      }
    }
  }
}
