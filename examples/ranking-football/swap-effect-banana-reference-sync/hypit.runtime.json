{
  "format": "qflow.runtime-local@1",
  "dataRoot": ".qflow/runtimes/local",
  "credentials": {
    "os": {
      "use": "@qflow/credential-store-os"
    },
    "env": {
      "use": "@qflow/credential-store-env"
    }
  },
  "endpoints": {
    "kie.default": {
      "use": "@qflow/provider-kie",
      "config": {
        "apiKey": {
          "store": "env",
          "key": "KIE_API_KEY"
        },
        "defaultConcurrency": 10
      }
    },
    "media.local": {
      "use": "@qflow/provider-media-local",
      "config": {
        "defaultConcurrency": 2
      }
    },
    "whisperx.local": {
      "use": "@qflow/provider-whisperx-local",
      "config": {
        "defaultConcurrency": 1
      }
    },
    "hyperframes.local": {
      "use": "@qflow/provider-hyperframes-local",
      "config": {
        "workers": 2,
        "quality": "standard",
        "defaultConcurrency": 1
      }
    }
  }
}
