{
  "format": "qflow.runtime-local@1",
  "dataRoot": ".qflow/runtimes/local",
  "credentials": {
    "env": {
      "use": "@qflow/credential-store-env"
    },
    "os": {
      "use": "@qflow/credential-store-os"
    }
  },
  "endpoints": {
    "qflowhub.default": {
      "use": "@qflow/provider-qflowhub",
      "pool": "generation",
      "config": {
        "baseUrl": "https://qflow.ai",
        "apiKey": {
          "store": "os",
          "key": "qflowhub.oauth"
        },
        "defaultConcurrency": 4,
        "requestTimeoutMs": 120000
      }
    },
    "media.local": {
      "use": "@qflow/provider-media-local",
      "pool": "media",
      "config": {
        "defaultConcurrency": 2
      }
    },
    "hyperframes.local": {
      "use": "@qflow/provider-hyperframes-local",
      "pool": "render",
      "config": {
        "workers": 2,
        "quality": "standard",
        "defaultConcurrency": 1
      }
    }
  }
}
