{
  "format": "qflow.runtime-local@1",
  "dataRoot": ".qflow/runtimes/local",
  "credentials": {
    "env": {
      "use": "@qflow/credential-store-env"
    },
    "local": {
      "use": "@qflow/credential-store-local"
    }
  },
  "endpoints": {
    "qflowhub.default": {
      "use": "@qflow/provider-qflowhub",
      "config": {
        "baseUrl": "https://qflow.ai",
        "apiKey": {
          "store": "local",
          "key": "qflowhub.oauth"
        },
        "defaultConcurrency": 4,
        "requestTimeoutMs": 120000
      }
    },
    "media.local": {
      "use": "@qflow/media-local",
      "config": {
        "defaultConcurrency": 2
      }
    },
    "html.local": {
      "use": "@qflow/provider-html-local",
      "config": {
        "workers": 2,
        "quality": "standard",
        "defaultConcurrency": 1
      }
    }
  }
}
