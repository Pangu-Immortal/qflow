{
  "format": "qflow.runtime-local@1",
  "dataRoot": ".qflow/execution",
  "credentials": { "local": { "use": "@qflow/credential-store-local" } },
  "endpoints": {
    "images.personal": {
      "use": "@example/provider-images",
      "config": { "baseUrl": "https://images.example", "apiKey": { "store": "local", "key": "images.personal" } }
    },
    "videos.personal": {
      "use": "@example/provider-videos",
      "config": { "baseUrl": "https://videos.example", "apiKey": { "store": "local", "key": "videos.personal" } }
    }
  },
  "bindings": {
    "@qflow/gpt-image@1#gpt-image-2": "images.personal",
    "@qflow/seedance@1#seedance-2-mini": "videos.personal"
  }
}
