{
  "format": "qflow.runtime-local@1",
  "dataRoot": ".qflow/execution",
  "credentials": { "platform": { "use": "@qflow/credential-store-platform" } },
  "endpoints": {
    "images.personal": {
      "use": "@example/provider-images",
      "config": { "baseUrl": "https://images.example", "apiKey": { "store": "platform", "key": "images.personal" } }
    }
  },
  "bindings": { "@qflow/gpt-image@1#gpt-image-2": "images.personal" }
}
