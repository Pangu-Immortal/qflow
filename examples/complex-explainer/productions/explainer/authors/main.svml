  <gfx:Flag id="road-flag" x="0.035" width="0.93" height="0.21" y="0.752" timeline={program.timeline} within={assets.canvas.bounds} logo={assets.flag-logo} from={story-time.moment-road-overview-cue} until={story-time.segment-timing-cost-end}/>
  <gfx:Flag id="closing-road-flag" x="0.035" width="0.93" height="0.21" y="0.752" timeline={program.timeline} within={assets.canvas.bounds} logo={assets.flag-logo} from={story-time.segment-synthesis-start} until={story-time.segment-closing-start}/>
