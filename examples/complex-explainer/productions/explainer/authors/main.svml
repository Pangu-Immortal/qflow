    <webscene:Beat name="copy" at={story-time.moment-outro-copy-cue}/>
    <webscene:Beat name="install" at={story-time.moment-outro-install-cue}/>
    <webscene:Beat name="gift" at={story-time.moment-outro-gift-cue}/>
    <webscene:Beat name="bye" at={story-time.moment-outro-bye-cue}/>
    <webscene:Beat name="end" at={story-time.segment-closing-end}/>
  </webscene:Outro>

  <!-- Final assembly: contributions and render targets -->
  <film:Film id="main" canvas={assets.canvas.canvas} timeline={program.timeline} appearance={look.film.main}>
    <film:Track source={presenter.visual}/>
    <film:Track source={voice.audio}/>
    <film:Track source={music.audio}/>
    <film:Track source={pixel-effects.audio}/>
    <film:Track source={captions.visual}/>
    <film:Track source={opening-title.visual}/>
    <film:Track source={series-timer.visual}/>
    <film:Track source={road-flag.visual}/>
    <film:Track source={closing-road-flag.visual}/>
    <film:Track source={opening-montage.visual}/>
    <film:Track source={montage-label.visual}/>
    <film:Track source={intro-scene.visual}/>
    <film:Track source={competitor-scene.visual}/>
    <film:Track source={editor-journey.visual}/>
    <film:Track source={code-journey.visual}/>
    <film:Track source={component-workshop.visual}/>
    <film:Track source={semantic-workshop.visual}/>
    <film:Track source={delivery-workshop.visual}/>
    <film:Track source={outro-scene.visual}/>
  </film:Film>
  <render:Video id="complete-film" composition={main.composition} timeline={program.timeline}/>
  <!-- Consecutive export ranges for limited temporary disk space. -->
  <render:Video id="export-part-1" composition={main.composition} timeline={program.timeline} start-frame="0" end-frame-exclusive="900"/>
  <render:Video id="export-part-2" composition={main.composition} timeline={program.timeline} start-frame="900" end-frame-exclusive="1800"/>
  <render:Video id="export-part-3" composition={main.composition} timeline={program.timeline} start-frame="1800" end-frame-exclusive="2700"/>
  <render:Video id="export-part-4" composition={main.composition} timeline={program.timeline} start-frame="2700" end-frame-exclusive="3600"/>
  <render:Video id="export-part-5" composition={main.composition} timeline={program.timeline} start-frame="3600" end-frame-exclusive="4112"/>
</svml>
