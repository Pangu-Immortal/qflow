    <audio:Clip id="sfx-montage-3" source={sfx-tap-media.media} from={story-time.segment-opening-end-plus-9f} until={story-time.segment-opening-end-plus-13f} gain="0.21"/>
    <audio:Clip id="sfx-montage-4" source={sfx-spark-media.media} from={story-time.segment-opening-end-plus-14f} until={story-time.segment-opening-end-plus-28f} gain="0.27"/>
  </audio:Track>

  <!-- Caption: Script text, authored cues and presentation -->
  <caption:Hidden id="hidden-captions"/>
  <caption-fine:Style id="caption-base" recipe={look.caption.primary} font={assets.display-font}/>
  <linecaption:Track id="captions" timeline={program.timeline}
    document={copy.story.caption} timing={caption-timing} within={assets.canvas.bounds}>
    <linecaption:Use style={caption-base}/>
    <linecaption:Use during={story-time.segment-opening} style={hidden-captions}/>
  </linecaption:Track>
  <launch:PosterTitle id="montage-label" timeline={program.timeline} within={assets.canvas.bounds} font={assets.display-font} from={story-time.segment-opening-end-plus-14f} until={story-time.segment-opening-end-plus-45f} text="Qflow" subtitle="复刻任何爆款视频" y="0.165" size="180" subtitle-size="46" subtitle-gap="35"/>

  <!-- Coordinated scenes: supplied media plus semantic events -->
  <webscene:Introduction id="intro-scene" timeline={program.timeline} within={assets.canvas.bounds} font={assets.display-font} during={story-time.segment-introduction} page={web-qflow-media.media} code={code-demo-media.media} readme={readme-demo-media.media} codex={assets.icon-codex} claude={assets.icon-claude} reference-ranking={reference-ranking-media.media} reference-podcast={reference-podcast-media.media} reference-interview={reference-interview-media.media} qflow-ranking={qflow-ranking-media.media} qflow-podcast={qflow-podcast-media.media} qflow-interview={qflow-interview-media.media}>
    <webscene:Beat name="language" at={story-time.moment-intro-language-cue}/>
    <webscene:Beat name="install" at={story-time.moment-intro-install-cue}/>
    <webscene:Beat name="codex" at={story-time.moment-intro-codex-cue}/>
    <webscene:Beat name="claude" at={story-time.moment-intro-claude-cue}/>
    <webscene:Beat name="examples" at={story-time.moment-intro-examples-cue}/>
    <webscene:Beat name="thirty" at={story-time.moment-intro-thirty-cue}/>
    <webscene:Beat name="face" at={story-time.moment-intro-face-cue}/>
    <webscene:Beat name="product" at={story-time.moment-intro-product-cue}/>
  </webscene:Introduction>
  <webscene:Comparison id="competitor-scene" timeline={program.timeline} within={assets.canvas.bounds} font={assets.display-font} during={story-time.segment-competitors} left={web-creatify-media.media} right={web-higgsfield-media.media} price-a={price-creatify-media.media} price-b={price-higgsfield-media.media} templates-a={templates-creatify-media.media} templates-b={templates-higgsfield-media.media} case-a={case-creatify-media.media} case-b={case-higgsfield-media.media} logo-a={assets.logo-creatify} logo-b={assets.logo-higgsfield}>
    <webscene:Beat name="other" at={story-time.moment-competitor-other-cue}/>
    <webscene:Beat name="monthly" at={story-time.moment-competitor-monthly-cue}/>
    <webscene:Beat name="templates" at={story-time.moment-competitor-templates-cue}/>
    <webscene:Beat name="cases" at={story-time.moment-competitor-cases-cue}/>
    <webscene:Beat name="watermark" at={story-time.moment-competitor-watermark-cue}/>
  </webscene:Comparison>
  <webscene:Road id="editor-journey" timeline={program.timeline} within={assets.canvas.bounds} font={assets.display-font} from={story-time.segment-two-roads-start} until={story-time.segment-keyframe-cost-end} page={web-qflow-media.media} sample={case-higgsfield-media.media} codex={assets.icon-codex} capcut={assets.icon-capcut} premiere={assets.icon-premiere} resolve={assets.icon-resolve} logo={assets.road-logo} portrait={assets.presenter-reference} thumb-a={assets.gallery-ranking} thumb-b={assets.gallery-podcast} thumb-c={assets.gallery-interview} thumb-d={assets.gallery-original-ranking} thumb-e={assets.gallery-original-interview} thumb-f={assets.gallery-homepage} thumb-g={assets.gallery-code}>
    <webscene:Beat name="half" at={story-time.moment-road-half-cue}/>
