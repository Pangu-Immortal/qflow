  <webscene:ComponentWorkshop id="component-workshop" timeline={program.timeline} within={assets.canvas.bounds} font={assets.display-font} during={story-time.segment-components} v0={ranking-clone-media.media} v1={swap-virtual-media.media} v2={swap-language-media.media} v3={swap-topic-media.media} v4={swap-product-media.media} v5={swap-vehicle-media.media}>
