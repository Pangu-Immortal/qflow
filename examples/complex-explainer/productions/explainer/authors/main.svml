    <webscene:Beat name="capcut" at={story-time.moment-road-capcut-cue}/>
    <webscene:Beat name="premiere" at={story-time.moment-road-premiere-cue}/>
    <webscene:Beat name="resolve" at={story-time.moment-road-resolve-cue}/>
    <webscene:Beat name="same" at={story-time.moment-road-same-cue}/>
    <webscene:Beat name="assets" at={story-time.moment-road-assets-cue}/>
    <webscene:Beat name="drag" at={story-time.moment-road-drag-cue}/>
    <webscene:Beat name="place" at={story-time.moment-road-place-cue}/>
    <webscene:Beat name="fail" at={story-time.moment-road-fail-cue}/>
    <webscene:Beat name="number" at={story-time.moment-road-number-cue}/>
    <webscene:Beat name="image" at={story-time.moment-road-image-cue}/>
    <webscene:Beat name="keys" at={story-time.moment-road-keys-cue}/>
