<?svml using="@qflow/markup@1"?>
<svml>
  <import as="copy" source="./script.svml"/>
  <import as="assets" source="./assets.svml"/>
  <import as="direction" source="./direction.svml"/>
  <import as="seedance" from="@qflow/seedance@1"/>
  <import as="pipeline" from="@qflow/media-pipeline@1"/>
  <import as="whisperx" from="@qflow/whisperx@1"/>
  <import as="time" from="@qflow/timeline-author@1"/>
  <import as="webscene" from="@explainer/web-scenes@1"/>
  <import as="launch" from="@explainer/launch-scenes@1"/>
  <import as="performance" from="@qflow/performance@1"/>
  <import as="sound" from="@qflow/sound@1"/>
  <import as="audio" from="@qflow/audio-track@1"/>
  <import as="caption" from="@qflow/caption@1"/>
  <import as="linecaption" from="@explainer/single-line-captions@1"/>
  <import as="caption-fine" from="@qflow/caption-fine@1"/>
  <import as="film" from="@qflow/film@1"/>
  <import as="render" from="@qflow/render-hyperframes@1"/>
  <import as="look" source="../recipes/composition.svs"/>
  <import as="gfx" from="@explainer/opening-system@1"/>
  <import as="spatial" from="@qflow/spatial@1"/>

  <!-- Prepared material outputs: explicit Run reuse boundaries -->
  <pipeline:Normalize id="bgm-media" source={assets.bgm-source} clock={assets.clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="web-qflow-media" source={assets.web-qflow} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="web-creatify-media" source={assets.web-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="web-higgsfield-media" source={assets.web-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <seedance:ReferenceVideo id="opening-generation" model="mini" prompt={direction.opening-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="opening-media" source={opening-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="opening" narrative={copy.story} segment={copy.story.segment.opening} media={opening-media.media} language="zh"/>
  <seedance:ReferenceVideo id="introduction-generation" model="mini" prompt={direction.introduction-prompt} duration="11" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="introduction-media" source={introduction-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="introduction" narrative={copy.story} segment={copy.story.segment.introduction} media={introduction-media.media} language="zh"/>
  <seedance:ReferenceVideo id="competitors-generation" model="mini" prompt={direction.competitors-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="competitors-media" source={competitors-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="competitors" narrative={copy.story} segment={copy.story.segment.competitors} media={competitors-media.media} language="zh"/>
  <seedance:ReferenceVideo id="two-roads-generation" model="mini" prompt={direction.two-roads-prompt} duration="6" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="two-roads-media" source={two-roads-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="two-roads" narrative={copy.story} segment={copy.story.segment.two-roads} media={two-roads-media.media} language="zh"/>
  <seedance:ReferenceVideo id="editor-road-generation" model="mini" prompt={direction.editor-road-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="editor-road-media" source={editor-road-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="editor-road" narrative={copy.story} segment={copy.story.segment.editor-road} media={editor-road-media.media} language="zh"/>
  <seedance:ReferenceVideo id="keyframe-cost-generation" model="mini" prompt={direction.keyframe-cost-prompt} duration="13" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="keyframe-cost-media" source={keyframe-cost-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="keyframe-cost" narrative={copy.story} segment={copy.story.segment.keyframe-cost} media={keyframe-cost-media.media} language="zh"/>
  <seedance:ReferenceVideo id="code-road-generation" model="mini" prompt={direction.code-road-prompt} duration="6" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="code-road-media" source={code-road-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="code-road" narrative={copy.story} segment={copy.story.segment.code-road} media={code-road-media.media} language="zh"/>
  <seedance:ReferenceVideo id="reuse-cost-generation" model="mini" prompt={direction.reuse-cost-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="reuse-cost-media" source={reuse-cost-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="reuse-cost" narrative={copy.story} segment={copy.story.segment.reuse-cost} media={reuse-cost-media.media} language="zh"/>
  <seedance:ReferenceVideo id="timing-cost-generation" model="mini" prompt={direction.timing-cost-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="timing-cost-media" source={timing-cost-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="timing-cost" narrative={copy.story} segment={copy.story.segment.timing-cost} media={timing-cost-media.media} language="zh"/>
  <seedance:ReferenceVideo id="water-break-generation" model="mini" prompt={direction.water-break-prompt} duration="4" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="water-break-media" source={water-break-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="water-break" narrative={copy.story} segment={copy.story.segment.water-break} media={water-break-media.media} language="zh"/>
  <seedance:ReferenceVideo id="synthesis-generation" model="mini" prompt={direction.synthesis-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="synthesis-media" source={synthesis-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="synthesis" narrative={copy.story} segment={copy.story.segment.synthesis} media={synthesis-media.media} language="zh"/>
  <seedance:ReferenceVideo id="components-generation" model="mini" prompt={direction.components-prompt} duration="12" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="components-media" source={components-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="components" narrative={copy.story} segment={copy.story.segment.components} media={components-media.media} language="zh"/>
  <seedance:ReferenceVideo id="semantic-time-generation" model="mini" prompt={direction.semantic-time-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="semantic-time-media" source={semantic-time-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="semantic-time" narrative={copy.story} segment={copy.story.segment.semantic-time} media={semantic-time-media.media} language="zh"/>
  <seedance:ReferenceVideo id="semantic-demo-generation" model="mini" prompt={direction.semantic-demo-prompt} duration="10" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="semantic-demo-media" source={semantic-demo-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="semantic-demo" narrative={copy.story} segment={copy.story.segment.semantic-demo} media={semantic-demo-media.media} language="zh"/>
  <seedance:ReferenceVideo id="result-generation" model="mini" prompt={direction.result-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="result-media" source={result-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="result" narrative={copy.story} segment={copy.story.segment.result} media={result-media.media} language="zh"/>
  <seedance:ReferenceVideo id="reference-reveal-generation" model="mini" prompt={direction.reference-reveal-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="reference-reveal-media" source={reference-reveal-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="reference-reveal" narrative={copy.story} segment={copy.story.segment.reference-reveal} media={reference-reveal-media.media} language="zh"/>
  <seedance:ReferenceVideo id="closing-generation" model="mini" prompt={direction.closing-prompt} duration="11" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="closing-media" source={closing-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="closing" narrative={copy.story} segment={copy.story.segment.closing} media={closing-media.media} language="zh"/>
  <pipeline:Normalize id="code-demo-media" source={assets.code-demo} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="readme-demo-media" source={assets.readme-demo} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="price-creatify-media" source={assets.price-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="price-higgsfield-media" source={assets.price-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="templates-creatify-media" source={assets.templates-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="templates-higgsfield-media" source={assets.templates-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="case-creatify-media" source={assets.case-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="case-higgsfield-media" source={assets.case-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="reference-ranking-media" source={assets.reference-ranking} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="reference-podcast-media" source={assets.reference-podcast} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="reference-interview-media" source={assets.reference-interview} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="qflow-ranking-media" source={assets.qflow-ranking} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="qflow-podcast-media" source={assets.qflow-podcast} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="qflow-interview-media" source={assets.qflow-interview} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>

  <!-- One Timeline: placed Takes, opening gap and silent ending -->
  <time:Timeline id="program" clock={assets.clock} end="content.end+2s">
    <time:Take source={opening.take}/>
    <time:Take source={introduction.take} at="previous.end+1.5s"/>
    <time:Take source={competitors.take}/>
    <time:Take source={two-roads.take}/>
    <time:Take source={editor-road.take}/>
    <time:Take source={keyframe-cost.take}/>
    <time:Take source={code-road.take}/>
    <time:Take source={reuse-cost.take}/>
    <time:Take source={timing-cost.take}/>
    <time:Take source={water-break.take}/>
    <time:Take source={synthesis.take}/>
    <time:Take source={components.take}/>
    <time:Take source={semantic-time.take}/>
    <time:Take source={semantic-demo.take}/>
    <time:Take source={result.take}/>
    <time:Take source={reference-reveal.take}/>
    <time:Take source={closing.take}/>
  </time:Timeline>
  <pipeline:Normalize id="ranking-clone-media" source={assets.ranking-clone} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="swap-virtual-media" source={assets.swap-virtual} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="swap-language-media" source={assets.swap-language} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="swap-topic-media" source={assets.swap-topic} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="swap-product-media" source={assets.swap-product} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="swap-vehicle-media" source={assets.swap-vehicle} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>

  <!-- Opening chrome and independent montage -->
  <gfx:Title id="opening-title" timeline={program.timeline} canvas={assets.canvas} font={assets.display-font} start="program.start" end="moment.cue" moment={copy.story.moment.begin} bounce-at={copy.story.moment.opening-brand} color="#fa67aa" title-y="0.58" title="Qflow" subtitle="一分钟了解" seconds="60"/>
  <gfx:Flag id="road-flag" x="0.035" width="0.93" height="0.21" y="0.752" timeline={program.timeline} canvas={assets.canvas} logo={assets.flag-logo} start="moment.cue" moment={copy.story.moment.road-overview} end-source={copy.story.segment.timing-cost} end="segment.end"/>
  <gfx:Flag id="closing-road-flag" x="0.035" width="0.93" height="0.21" y="0.752" timeline={program.timeline} canvas={assets.canvas} logo={assets.flag-logo} start-source={copy.story.segment.synthesis} start="segment.start" end-source={copy.story.segment.closing} end="segment.start"/>
  <gfx:Timer flag-amplitude="0.06" logo={assets.flag-logo} id="series-timer" timeline={program.timeline} canvas={assets.canvas} font={assets.display-font} start="moment.cue" end="program.end" moment={copy.story.moment.begin} stop-at={copy.story.moment.outro-overtime} flag-color="#fa67aa" title="Qflow" subtitle="VIDEO FRAMEWORK" seconds="60"/>
  <gfx:Stage id="opening-montage" push-rate="0.025" timeline={program.timeline} canvas={assets.canvas} start="segment.end" end="segment.end+1.5s" segment={copy.story.segment.opening}>
    <gfx:Item id="image-1" image={assets.montage-1} segment={copy.story.segment.opening} start="segment.end+0f" end="segment.end+5f"/>
    <gfx:Item id="image-2" image={assets.montage-2} segment={copy.story.segment.opening} start="segment.end+5f" end="segment.end+9f"/>
    <gfx:Item id="image-3" image={assets.montage-3} segment={copy.story.segment.opening} start="segment.end+9f" end="segment.end+14f"/>
    <gfx:Item id="image-4" image={assets.montage-4} segment={copy.story.segment.opening} start="segment.end+14f" end="segment.end+45f"/>
  </gfx:Stage>

  <!-- Presenter presentation: Uses select framing without changing playback -->
  <spatial:Frame id="full-frame" within={assets.canvas} left="0%" top="0%" right="100%" bottom="100%"/>
  <spatial:AnchoredFrame id="host-inset" within={assets.canvas} x="93%" y="13.5%" width="330px" height="330px" anchor="top-right"/>
  <performance:Style id="host-hidden" frame={full-frame} appearance={look.media.hidden}/>
  <performance:Style id="host-full" frame={full-frame} appearance={look.media.full}/>
  <gfx:PortraitInset id="host-small" frame={host-inset}/>
  <gfx:Pullback id="opening-pullback" scale="1.5"/>
  <gfx:FadeOut id="host-fade"/>
  <spatial:Frame id="upper-frame" within={assets.canvas} left="0%" top="0%" right="100%" bottom="48%"/>
  <performance:Style id="host-upper" frame={upper-frame} appearance={look.media.upper}/>
  <gfx:Reframe id="host-rise" from={full-frame} to={upper-frame}/>
  <gfx:PortraitTransition id="host-resume" from={full-frame} to={host-inset}/>
  <performance:Track id="presenter" timeline={program.timeline} canvas={assets.canvas}>
    <performance:Use style={host-small} segment={copy.story.segment.introduction} start="segment.start" end="program.end"/>
    <performance:Use during={copy.story.segment.opening} style={host-full}/>
    <performance:Use start="0f" end="1s" style={opening-pullback}/>
    <performance:Use during={copy.story.segment.two-roads} style={host-full}/>
    <performance:Use segment={copy.story.segment.two-roads} start="segment.start" end="segment.start+1s" style={opening-pullback}/>
    <performance:Use start-source={copy.story.moment.road-half} start="moment.cue" end-source={copy.story.moment.road-overview} end="moment.cue" style={host-upper}/>
    <performance:Use at={copy.story.moment.road-half} for="14f" style={host-rise}/>
    <performance:Use segment={copy.story.segment.two-roads} moment={copy.story.moment.road-overview} start="moment.cue" end="segment.end" style={host-small}/>
    <performance:Use during={copy.story.segment.water-break} style={host-full}/>
    <performance:Use moment={copy.story.moment.resume} start="moment.cue" end="program.end" style={host-small}/>
    <performance:Use at={copy.story.moment.resume} for="18f" style={host-resume}/>
    <performance:Use during={copy.story.segment.closing} style={host-full}/>
    <performance:Use segment={copy.story.segment.closing} start="segment.start" end="segment.start+1s" style={opening-pullback}/>
    <performance:Use start-source={copy.story.moment.outro-github} start="moment.cue" end-source={copy.story.moment.outro-bye} end="moment.cue" style={host-small}/>
    <performance:Use during={copy.story.segment.timing-cost} style={host-hidden}/>
    <performance:Use start-source={copy.story.moment.result-guess} start="moment.cue" end-source={copy.story.segment.reference-reveal} end="segment.end" style={host-hidden}/>
    <performance:Use segment={copy.story.segment.closing} start="segment.end-12f" end="segment.end" style={host-fade}/>
    <performance:Use segment={copy.story.segment.closing} start="segment.end" end="program.end" style={host-hidden}/>
  </performance:Track>
  <sound:Style id="normal-voice"/>

  <!-- Voice, music and independently authored effects -->
  <sound:Track id="voice" timeline={program.timeline}>
    <sound:Use style={normal-voice}/>
  </sound:Track>
  <audio:Track id="music" timeline={program.timeline}>
    <audio:Item id="bgm" source={bgm-media.media} during="program" playback="once" gain="0.09" fade-in="6f" fade-out="2s"/>
  </audio:Track>
  <pipeline:Normalize id="sfx-tap-media" source={assets.sfx-tap} clock={assets.clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="sfx-pop-media" source={assets.sfx-pop} clock={assets.clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="sfx-swipe-media" source={assets.sfx-swipe} clock={assets.clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="sfx-land-media" source={assets.sfx-land} clock={assets.clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="sfx-reject-media" source={assets.sfx-reject} clock={assets.clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="sfx-ticks-media" source={assets.sfx-ticks} clock={assets.clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="sfx-spark-media" source={assets.sfx-spark} clock={assets.clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="sfx-finish-media" source={assets.sfx-finish} clock={assets.clock} video="none" audio="default" span-authority="audio"/>
  <audio:Track id="pixel-effects" timeline={program.timeline}>
    <audio:Item id="sfx-intro-codex" source={sfx-pop-media.media} at={copy.story.moment.intro-codex} for="0.24s" playback="once" gain="0.16" fade-out="1f"/>
    <audio:Item id="sfx-intro-claude" source={sfx-pop-media.media} at={copy.story.moment.intro-claude} for="0.24s" playback="once" gain="0.16" fade-out="1f"/>
    <audio:Item id="sfx-intro-examples" source={sfx-swipe-media.media} at={copy.story.moment.intro-examples} for="0.36s" playback="once" gain="0.2" fade-out="1f"/>
    <audio:Item id="sfx-intro-face" source={sfx-spark-media.media} at={copy.story.moment.intro-face} for="0.48s" playback="once" gain="0.13" fade-out="1f"/>
    <audio:Item id="sfx-competitor-monthly" source={sfx-tap-media.media} at={copy.story.moment.competitor-monthly} for="0.12s" playback="once" gain="0.16" fade-out="1f"/>
    <audio:Item id="sfx-competitor-watermark" source={sfx-ticks-media.media} at={copy.story.moment.competitor-watermark} for="0.65s" playback="once" gain="0.13" fade-out="1f"/>
    <audio:Item id="sfx-roads" source={sfx-land-media.media} at={copy.story.moment.roads} for="0.26s" playback="once" gain="0.22" fade-out="1f"/>
