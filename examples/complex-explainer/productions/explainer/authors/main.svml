    <webscene:Beat name="guess" at={story-time.moment-result-guess-cue}/>
  </webscene:DeliveryWorkshop>
  <webscene:Outro id="outro-scene" timeline={program.timeline} within={assets.canvas.bounds} font={assets.display-font} from={story-time.segment-closing-start} until="end" page={readme-demo-media.media} codex={assets.icon-codex} portraits-0={assets.portraits-0} portraits-1={assets.portraits-1} portraits-2={assets.portraits-2} portraits-3={assets.portraits-3} portraits-4={assets.portraits-4}>
    <webscene:Beat name="overtime" at={story-time.moment-outro-overtime-cue}/>
