    <gfx:Source id="water-break-source" media={water-break-media.media} window={program.water-break}/>
    <gfx:Source id="synthesis-source" media={synthesis-media.media} window={program.synthesis}/>
    <gfx:Source id="components-source" media={components-media.media} window={program.components}/>
    <gfx:Source id="semantic-time-source" media={semantic-time-media.media} window={program.semantic-time}/>
    <gfx:Source id="semantic-demo-source" media={semantic-demo-media.media} window={program.semantic-demo}/>
    <gfx:Source id="result-source" media={result-media.media} window={program.result}/>
    <gfx:Source id="reference-reveal-source" media={reference-reveal-media.media} window={program.reference-reveal}/>
    <gfx:Source id="closing-source" media={closing-media.media} window={program.closing}/>
    <gfx:Use style={host-small} from={story-time.segment-introduction-start} until="end"/>
    <gfx:Use during={story-time.segment-opening} style={host-full}/>
    <gfx:Use from="0f" until="1s" style={opening-pullback}/>
    <gfx:Use during={story-time.segment-two-roads} style={host-full}/>
    <gfx:Use from={story-time.segment-two-roads-start} until={story-time.segment-two-roads-start-plus-1s} style={opening-pullback}/>
    <gfx:Use from={story-time.moment-road-half-cue} until={story-time.moment-road-overview-cue} style={host-upper}/>
    <gfx:Use from={story-time.moment-road-half-cue} for="14f" style={host-rise}/>
    <gfx:Use from={story-time.moment-road-overview-cue} until={story-time.segment-two-roads-end} style={host-small}/>
    <gfx:Use during={story-time.segment-water-break} style={host-full}/>
    <gfx:Use from={story-time.moment-resume-cue} until="end" style={host-small}/>
    <gfx:Use from={story-time.moment-resume-cue} for="18f" style={host-resume}/>
    <gfx:Use during={story-time.segment-closing} style={host-full}/>
    <gfx:Use from={story-time.segment-closing-start} until={story-time.segment-closing-start-plus-1s} style={opening-pullback}/>
    <gfx:Use from={story-time.moment-outro-github-cue} until={story-time.moment-outro-bye-cue} style={host-small}/>
    <gfx:Use during={story-time.segment-timing-cost} style={host-hidden}/>
    <gfx:Use from={story-time.moment-result-guess-cue} until={story-time.segment-reference-reveal-end} style={host-hidden}/>
    <gfx:Use from={story-time.segment-closing-end-minus-12f} until={story-time.segment-closing-end} style={host-fade}/>
    <gfx:Use from={story-time.segment-closing-end} until="end" style={host-hidden}/>
