  <webscene:CodeJourney id="code-journey" timeline={program.timeline} within={assets.canvas.bounds} font={assets.display-font} from={story-time.segment-code-road-start} until={story-time.segment-synthesis-end} codex={assets.icon-codex} remotion={assets.icon-remotion} hyperframes={assets.icon-hyperframes} ranking={reference-ranking-media.media} podcast={reference-podcast-media.media} interview={reference-interview-media.media} target={qflow-ranking-media.media}>
    <webscene:Beat name="remotion" at={story-time.moment-code-remotion-cue}/>
    <webscene:Beat name="hyperframes" at={story-time.moment-code-hyperframes-cue}/>
    <webscene:Beat name="html" at={story-time.moment-code-html-cue}/>
    <webscene:Beat name="play" at={story-time.moment-code-play-cue}/>
