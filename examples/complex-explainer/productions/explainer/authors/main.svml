  <webscene:DeliveryWorkshop id="delivery-workshop" timeline={program.timeline} within={assets.canvas.bounds} font={assets.display-font} from={story-time.segment-result-start} until={story-time.segment-reference-reveal-end} film={qflow-ranking-media.media} clone={ranking-clone-media.media} water={water-break-media.media} reference={assets.reference-drink-illustration} host={assets.ranking-host} thumb1={assets.ranking-icon} thumb2={assets.ranking-creatify} thumb3={assets.ranking-higgsfield}>
    <webscene:Beat name="assets" at={story-time.moment-result-assets-cue}/>
