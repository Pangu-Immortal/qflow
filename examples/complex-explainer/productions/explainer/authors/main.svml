    <webscene:Beat name="variants" at={story-time.moment-parts-word-cue}/>
    <webscene:Beat name="word" at={story-time.moment-parts-word-cue}/>
    <webscene:Beat name="picture" at={story-time.moment-parts-picture-cue}/>
    <webscene:Beat name="color" at={story-time.moment-parts-color-cue}/>
    <webscene:Beat name="swap" at={story-time.moment-parts-swap-cue}/>
  </webscene:ComponentWorkshop>
  <webscene:SemanticWorkshop id="semantic-workshop" timeline={program.timeline} within={assets.canvas.bounds} font={assets.display-font} creatify={assets.ranking-creatify} higgsfield={assets.ranking-higgsfield} from={story-time.segment-semantic-time-start} until={story-time.segment-semantic-demo-end}>
    <webscene:Beat name="bind" at={story-time.moment-sem-bind-cue}/>
    <webscene:Beat name="examples" at={story-time.moment-sem-examples-cue}/>
    <webscene:Beat name="rank" at={story-time.moment-rank-reveal-cue}/>
    <webscene:Beat name="product" at={story-time.moment-product-reveal-cue}/>
    <webscene:Beat name="rewrite-scene" at={story-time.moment-sem-rewrite-scene-cue}/>
