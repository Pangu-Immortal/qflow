<?svml using="@qflow/markup@1"?>
<svml>

  <import as="media" from="@qflow/media@1"/>
  <import as="copy" source="./script.svml"/>
  <import as="assets" source="./assets.svml"/>
  <import as="direction" source="./direction.svml"/>
  <import as="seedance" from="@qflow/seedance@1"/>
  <import as="pipeline" from="@qflow/media-pipeline@1"/>
  <import as="whisperx" from="@qflow/whisperx@1"/>
  <import as="semantic" from="@qflow/narrative-temporal@1"/>
  <import as="time" from="@qflow/timeline-author@1"/>
  <import as="webscene" from="@explainer/web-scenes@1"/>
  <import as="launch" from="@explainer/launch-scenes@1"/>
  <import as="visual" from="@qflow/visual-track@1"/>
  <import as="audio" from="@qflow/audio-track@1"/>
  <import as="caption" from="@qflow/caption@1"/>
  <import as="narrative-caption" from="@qflow/narrative-caption@1"/>
  <import as="linecaption" from="@explainer/single-line-captions@1"/>
  <import as="caption-fine" from="@qflow/caption-fine@1"/>
  <import as="film" from="@qflow/film@1"/>
  <import as="render" from="@qflow/render-hyperframes@1"/>
  <import as="look" source="../recipes/composition.svs"/>
  <import as="gfx" from="@explainer/opening-system@1"/>
  <import as="spatial" from="@qflow/spatial@1"/>

  <!-- Prepared material outputs: explicit Run reuse boundaries -->
  <pipeline:Normalize id="bgm-media" source={assets.bgm-source} clock={assets.clock} video="none" audio="default" span-authority="audio"/>
  <pipeline:Normalize id="web-qflow-media" source={assets.web-qflow} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="web-creatify-media" source={assets.web-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="web-higgsfield-media" source={assets.web-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <seedance:ReferenceVideo id="opening-generation" model="mini" prompt={direction.opening-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="opening-media" source={opening-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="opening" narrative={copy.story}
    segment={copy.story.segment.opening} media={opening-media.media} domain={opening-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="introduction-generation" model="mini" prompt={direction.introduction-prompt} duration="11" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="introduction-media" source={introduction-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="introduction" narrative={copy.story}
    segment={copy.story.segment.introduction} media={introduction-media.media} domain={introduction-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="competitors-generation" model="mini" prompt={direction.competitors-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="competitors-media" source={competitors-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="competitors" narrative={copy.story}
    segment={copy.story.segment.competitors} media={competitors-media.media} domain={competitors-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="two-roads-generation" model="mini" prompt={direction.two-roads-prompt} duration="6" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="two-roads-media" source={two-roads-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="two-roads" narrative={copy.story}
    segment={copy.story.segment.two-roads} media={two-roads-media.media} domain={two-roads-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="editor-road-generation" model="mini" prompt={direction.editor-road-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="editor-road-media" source={editor-road-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="editor-road" narrative={copy.story}
    segment={copy.story.segment.editor-road} media={editor-road-media.media} domain={editor-road-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="keyframe-cost-generation" model="mini" prompt={direction.keyframe-cost-prompt} duration="13" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="keyframe-cost-media" source={keyframe-cost-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="keyframe-cost" narrative={copy.story}
    segment={copy.story.segment.keyframe-cost} media={keyframe-cost-media.media} domain={keyframe-cost-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="code-road-generation" model="mini" prompt={direction.code-road-prompt} duration="6" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="code-road-media" source={code-road-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="code-road" narrative={copy.story}
    segment={copy.story.segment.code-road} media={code-road-media.media} domain={code-road-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="reuse-cost-generation" model="mini" prompt={direction.reuse-cost-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="reuse-cost-media" source={reuse-cost-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="reuse-cost" narrative={copy.story}
    segment={copy.story.segment.reuse-cost} media={reuse-cost-media.media} domain={reuse-cost-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="timing-cost-generation" model="mini" prompt={direction.timing-cost-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="timing-cost-media" source={timing-cost-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="timing-cost" narrative={copy.story}
    segment={copy.story.segment.timing-cost} media={timing-cost-media.media} domain={timing-cost-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="water-break-generation" model="mini" prompt={direction.water-break-prompt} duration="4" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="water-break-media" source={water-break-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="water-break" narrative={copy.story}
    segment={copy.story.segment.water-break} media={water-break-media.media} domain={water-break-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="synthesis-generation" model="mini" prompt={direction.synthesis-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="synthesis-media" source={synthesis-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="synthesis" narrative={copy.story}
    segment={copy.story.segment.synthesis} media={synthesis-media.media} domain={synthesis-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="components-generation" model="mini" prompt={direction.components-prompt} duration="12" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="components-media" source={components-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="components" narrative={copy.story}
    segment={copy.story.segment.components} media={components-media.media} domain={components-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="semantic-time-generation" model="mini" prompt={direction.semantic-time-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="semantic-time-media" source={semantic-time-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="semantic-time" narrative={copy.story}
    segment={copy.story.segment.semantic-time} media={semantic-time-media.media} domain={semantic-time-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="semantic-demo-generation" model="mini" prompt={direction.semantic-demo-prompt} duration="10" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="semantic-demo-media" source={semantic-demo-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="semantic-demo" narrative={copy.story}
    segment={copy.story.segment.semantic-demo} media={semantic-demo-media.media} domain={semantic-demo-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="result-generation" model="mini" prompt={direction.result-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="result-media" source={result-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="result" narrative={copy.story}
    segment={copy.story.segment.result} media={result-media.media} domain={result-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="reference-reveal-generation" model="mini" prompt={direction.reference-reveal-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="reference-reveal-media" source={reference-reveal-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="reference-reveal" narrative={copy.story}
    segment={copy.story.segment.reference-reveal} media={reference-reveal-media.media} domain={reference-reveal-media.domain} language="zh"/>
  <seedance:ReferenceVideo id="closing-generation" model="mini" prompt={direction.closing-prompt} duration="11" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <pipeline:Normalize id="closing-media" source={closing-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Alignment id="closing" narrative={copy.story}
    segment={copy.story.segment.closing} media={closing-media.media} domain={closing-media.domain} language="zh"/>
  <pipeline:Normalize id="code-demo-media" source={assets.code-demo} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="readme-demo-media" source={assets.readme-demo} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="price-creatify-media" source={assets.price-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="price-higgsfield-media" source={assets.price-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="templates-creatify-media" source={assets.templates-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="templates-higgsfield-media" source={assets.templates-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="case-creatify-media" source={assets.case-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="case-higgsfield-media" source={assets.case-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="reference-ranking-media" source={assets.reference-ranking} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="reference-podcast-media" source={assets.reference-podcast} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="reference-interview-media" source={assets.reference-interview} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="qflow-ranking-media" source={assets.qflow-ranking} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="qflow-podcast-media" source={assets.qflow-podcast} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <pipeline:Normalize id="qflow-interview-media" source={assets.qflow-interview} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>

  <!-- One Timeline: placed Takes, opening gap and silent ending -->
  <time:Timeline id="program" clock={assets.clock} end="closing.end+2s">
    <time:Window id="opening" from="start" for={opening-media.extent}/>
    <time:Window id="introduction" from="opening.end+1.5s" for={introduction-media.extent}/>
    <time:Window id="competitors" from="introduction.end" for={competitors-media.extent}/>
    <time:Window id="two-roads" from="competitors.end" for={two-roads-media.extent}/>
    <time:Window id="editor-road" from="two-roads.end" for={editor-road-media.extent}/>
    <time:Window id="keyframe-cost" from="editor-road.end" for={keyframe-cost-media.extent}/>
    <time:Window id="code-road" from="keyframe-cost.end" for={code-road-media.extent}/>
    <time:Window id="reuse-cost" from="code-road.end" for={reuse-cost-media.extent}/>
    <time:Window id="timing-cost" from="reuse-cost.end" for={timing-cost-media.extent}/>
    <time:Window id="water-break" from="timing-cost.end" for={water-break-media.extent}/>
    <time:Window id="synthesis" from="water-break.end" for={synthesis-media.extent}/>
    <time:Window id="components" from="synthesis.end" for={components-media.extent}/>
    <time:Window id="semantic-time" from="components.end" for={semantic-time-media.extent}/>
    <time:Window id="semantic-demo" from="semantic-time.end" for={semantic-demo-media.extent}/>
    <time:Window id="result" from="semantic-demo.end" for={result-media.extent}/>
    <time:Window id="reference-reveal" from="result.end" for={reference-reveal-media.extent}/>
    <time:Window id="closing" from="reference-reveal.end" for={closing-media.extent}/>
  </time:Timeline>


  <semantic:Projection id="story-time" narrative={copy.story} timeline={program.timeline}>
    <semantic:Map alignment={opening.alignment} domain={opening-media.domain} window={program.opening}/>
    <semantic:Map alignment={introduction.alignment} domain={introduction-media.domain} window={program.introduction}/>
    <semantic:Map alignment={competitors.alignment} domain={competitors-media.domain} window={program.competitors}/>
    <semantic:Map alignment={two-roads.alignment} domain={two-roads-media.domain} window={program.two-roads}/>
    <semantic:Map alignment={editor-road.alignment} domain={editor-road-media.domain} window={program.editor-road}/>
    <semantic:Map alignment={keyframe-cost.alignment} domain={keyframe-cost-media.domain} window={program.keyframe-cost}/>
    <semantic:Map alignment={code-road.alignment} domain={code-road-media.domain} window={program.code-road}/>
    <semantic:Map alignment={reuse-cost.alignment} domain={reuse-cost-media.domain} window={program.reuse-cost}/>
    <semantic:Map alignment={timing-cost.alignment} domain={timing-cost-media.domain} window={program.timing-cost}/>
    <semantic:Map alignment={water-break.alignment} domain={water-break-media.domain} window={program.water-break}/>
    <semantic:Map alignment={synthesis.alignment} domain={synthesis-media.domain} window={program.synthesis}/>
    <semantic:Map alignment={components.alignment} domain={components-media.domain} window={program.components}/>
    <semantic:Map alignment={semantic-time.alignment} domain={semantic-time-media.domain} window={program.semantic-time}/>
    <semantic:Map alignment={semantic-demo.alignment} domain={semantic-demo-media.domain} window={program.semantic-demo}/>
    <semantic:Map alignment={result.alignment} domain={result-media.domain} window={program.result}/>
    <semantic:Map alignment={reference-reveal.alignment} domain={reference-reveal-media.domain} window={program.reference-reveal}/>
    <semantic:Map alignment={closing.alignment} domain={closing-media.domain} window={program.closing}/>
    <semantic:Instant id="moment-begin-cue" moment={copy.story.moment.begin}/>
    <semantic:Instant id="moment-opening-brand-cue" moment={copy.story.moment.opening-brand}/>
    <semantic:Instant id="moment-road-overview-cue" moment={copy.story.moment.road-overview}/>
    <semantic:Instant id="segment-timing-cost-end" segment={copy.story.segment.timing-cost} boundary="end"/>
    <semantic:Instant id="segment-synthesis-start" segment={copy.story.segment.synthesis} boundary="start"/>
    <semantic:Instant id="segment-closing-start" segment={copy.story.segment.closing} boundary="start"/>
    <semantic:Instant id="moment-outro-overtime-cue" moment={copy.story.moment.outro-overtime}/>
    <semantic:Instant id="segment-opening-end" segment={copy.story.segment.opening} boundary="end"/>
    <semantic:Instant id="segment-opening-end-plus-1-5s" segment={copy.story.segment.opening} boundary="end" offset="+1.5s"/>
    <semantic:Instant id="segment-opening-end-plus-0f" segment={copy.story.segment.opening} boundary="end" offset="+0f"/>
    <semantic:Instant id="segment-opening-end-plus-5f" segment={copy.story.segment.opening} boundary="end" offset="+5f"/>
    <semantic:Instant id="segment-opening-end-plus-9f" segment={copy.story.segment.opening} boundary="end" offset="+9f"/>
    <semantic:Instant id="segment-opening-end-plus-14f" segment={copy.story.segment.opening} boundary="end" offset="+14f"/>
    <semantic:Instant id="segment-opening-end-plus-45f" segment={copy.story.segment.opening} boundary="end" offset="+45f"/>
    <semantic:Instant id="segment-introduction-start" segment={copy.story.segment.introduction} boundary="start"/>
    <semantic:Window id="segment-opening" segment={copy.story.segment.opening}/>
    <semantic:Window id="segment-two-roads" segment={copy.story.segment.two-roads}/>
    <semantic:Instant id="segment-two-roads-start" segment={copy.story.segment.two-roads} boundary="start"/>
    <semantic:Instant id="segment-two-roads-start-plus-1s" segment={copy.story.segment.two-roads} boundary="start" offset="+1s"/>
    <semantic:Instant id="moment-road-half-cue" moment={copy.story.moment.road-half}/>
    <semantic:Instant id="segment-two-roads-end" segment={copy.story.segment.two-roads} boundary="end"/>
    <semantic:Window id="segment-water-break" segment={copy.story.segment.water-break}/>
    <semantic:Instant id="moment-resume-cue" moment={copy.story.moment.resume}/>
    <semantic:Window id="segment-closing" segment={copy.story.segment.closing}/>
    <semantic:Instant id="segment-closing-start-plus-1s" segment={copy.story.segment.closing} boundary="start" offset="+1s"/>
    <semantic:Instant id="moment-outro-github-cue" moment={copy.story.moment.outro-github}/>
    <semantic:Instant id="moment-outro-bye-cue" moment={copy.story.moment.outro-bye}/>
    <semantic:Window id="segment-timing-cost" segment={copy.story.segment.timing-cost}/>
    <semantic:Instant id="moment-result-guess-cue" moment={copy.story.moment.result-guess}/>
    <semantic:Instant id="segment-reference-reveal-end" segment={copy.story.segment.reference-reveal} boundary="end"/>
    <semantic:Instant id="segment-closing-end-minus-12f" segment={copy.story.segment.closing} boundary="end" offset="-12f"/>
    <semantic:Instant id="segment-closing-end" segment={copy.story.segment.closing} boundary="end"/>
    <semantic:Instant id="moment-intro-codex-cue" moment={copy.story.moment.intro-codex}/>
    <semantic:Instant id="moment-intro-claude-cue" moment={copy.story.moment.intro-claude}/>
    <semantic:Instant id="moment-intro-examples-cue" moment={copy.story.moment.intro-examples}/>
    <semantic:Instant id="moment-intro-face-cue" moment={copy.story.moment.intro-face}/>
    <semantic:Instant id="moment-competitor-monthly-cue" moment={copy.story.moment.competitor-monthly}/>
    <semantic:Instant id="moment-competitor-watermark-cue" moment={copy.story.moment.competitor-watermark}/>
    <semantic:Instant id="moment-roads-cue" moment={copy.story.moment.roads}/>
    <semantic:Instant id="moment-road-assets-cue" moment={copy.story.moment.road-assets}/>
    <semantic:Instant id="moment-road-drag-cue" moment={copy.story.moment.road-drag}/>
    <semantic:Instant id="moment-road-fail-cue" moment={copy.story.moment.road-fail}/>
    <semantic:Instant id="moment-road-number-cue" moment={copy.story.moment.road-number}/>
    <semantic:Instant id="moment-road-image-cue" moment={copy.story.moment.road-image}/>
    <semantic:Instant id="moment-road-keys-cue" moment={copy.story.moment.road-keys}/>
    <semantic:Instant id="moment-road-tokens-cue" moment={copy.story.moment.road-tokens}/>
    <semantic:Instant id="moment-code-play-cue" moment={copy.story.moment.code-play}/>
    <semantic:Instant id="moment-code-duplicate-cue" moment={copy.story.moment.code-duplicate}/>
    <semantic:Instant id="moment-solution-keep-cue" moment={copy.story.moment.solution-keep}/>
    <semantic:Instant id="moment-solution-drop-cue" moment={copy.story.moment.solution-drop}/>
    <semantic:Instant id="moment-part-caption-cue" moment={copy.story.moment.part-caption}/>
    <semantic:Instant id="moment-part-ranking-cue" moment={copy.story.moment.part-ranking}/>
    <semantic:Instant id="moment-part-chart-cue" moment={copy.story.moment.part-chart}/>
    <semantic:Instant id="moment-part-card-cue" moment={copy.story.moment.part-card}/>
    <semantic:Instant id="moment-parts-library-cue" moment={copy.story.moment.parts-library}/>
    <semantic:Instant id="moment-parts-reuse-cue" moment={copy.story.moment.parts-reuse}/>
    <semantic:Instant id="moment-parts-swap-cue" moment={copy.story.moment.parts-swap}/>
    <semantic:Instant id="moment-rank-reveal-cue" moment={copy.story.moment.rank-reveal}/>
