{
  "format": "qflow.runtime-profile@1",
  "runtime": {
    "use": "@qflow/runtime-local",
    "config": {
      "dataRoot": ".qflow/runtimes/local-v4",
      "artifacts": { "use": "@qflow/artifact-store-fs", "config": { "path": "artifacts" } },
      "credentials": { "env": { "use": "@qflow/credential-store-env" } },
      "endpoints": {
        "qflowhub.smoke": {
          "use": "@qflow/provider-qflowhub",
          "pool": "qflowhub.smoke-v4",
          "config": {
            "baseUrl": "https://qflow.ai/v1",
            "apiKey": { "store": "env", "key": "QFLOWHUB_API_KEY" },
            "defaultConcurrency": 1,
            "pollIntervalMs": 5000,
            "requestTimeoutMs": 120000,
            "audio": false
          }
        },
        "xiaomi-mimo.smoke": {
          "use": "@qflow/provider-xiaomi-mimo",
          "pool": "xiaomi-mimo.smoke",
          "config": {
            "apiBaseUrl": "https://api.xiaomimimo.com/v1",
            "apiKey": { "store": "env", "key": "MIMO_API_KEY" },
            "defaultConcurrency": 2,
            "requestTimeoutMs": 180000
          }
        }
      }
    }
  }
}
